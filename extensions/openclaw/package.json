{
  "name": "@denied-dev/denied-openclaw-plugin",
  "version": "0.5.1",
  "description": "Denied SDK Hook Plugin for OpenClaw",
  "keywords": [
    "denied",
    "sdk",
    "openclaw",
    "authorization"
  ],
  "homepage": "https://github.com/denied-dev/denied-sdk#readme",
  "bugs": {
    "url": "https://github.com/denied-dev/denied-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denied-dev/denied-sdk.git",
    "directory": "extensions/openclaw"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Denied Technologies",
    "email": "support@denied.dev"
  },
  "type": "module",
  "files": [
    "./dist",
    "./index.ts",
    "./src",
    "./openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.12"
    }
  },
  "dependencies": {
    "@denied-dev/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.0"
  }
}
